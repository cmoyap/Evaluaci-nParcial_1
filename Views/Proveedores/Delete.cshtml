@model Sistema_de_Gestión_de_Inventarios.Models.Proveedor

@{
    ViewData["Title"] = "Eliminar proveedor";
}

<h1>Eliminar</h1>

<h3>¿Seguro que deseas eliminar este proveedor?</h3>

<dl class="row">
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="ProveedorId" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
