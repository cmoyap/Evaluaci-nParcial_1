@{
    ViewData["Title"] = "Nueva orden de compra";
}

<h1>Nueva orden de compra</h1>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label for="ProveedorId" class="form-label">Proveedor</label>
        <select name="ProveedorId" class="form-select" asp-items="ViewBag.ProveedorId"></select>
    </div>

    <div class="mb-3">
        <label for="ProductoId" class="form-label">Producto</label>
        <select name="ProductoId" class="form-select" asp-items="ViewBag.ProductoId"></select>
    </div>

    <div class="mb-3">
        <label for="Cantidad" class="form-label">Cantidad</label>
        <input name="Cantidad" type="number" class="form-control" value="1" min="1" />
    </div>

    <div class="mb-3">
        <label for="PrecioUnitario" class="form-label">Precio unitario</label>
        <input name="PrecioUnitario" type="number" step="0.01" class="form-control" value="0" />
    </div>

    <button type="submit" class="btn btn-primary">Crear orden</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
